---
/** Ringkasan jadwal pekanan per hari (beranda). Hari ini & sesi berikutnya ditandai di browser. */
import { activeKajian, teachers } from '../data/kajian';
import { DAYS, flattenSessions, formatTime } from '../lib/schedule';

const sessions = flattenSessions(activeKajian, teachers);
const days = DAYS.map((name, day) => ({ name, day, items: sessions.filter((s) => s.day === day) }));
---

<div class="-mx-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0" data-week-strip>
  <ol class="grid min-w-[760px] grid-cols-7 gap-2">
    {
      days.map((d) => (
        <li class="flex flex-col rounded-2xl border border-line bg-white p-3" data-day={d.day}>
          <p class="flex items-center justify-between text-sm font-extrabold text-ink">
            {d.name}
            <span class="badge hidden bg-gold/15 !px-2 !py-0.5 text-[0.65rem] text-[#7A5A16]" data-today-badge>
              Hari ini
            </span>
          </p>
          <div class="mt-3 flex flex-1 flex-col gap-2">
            {d.items.length ? (
              d.items.map((s) => (
                <a
                  href={`/kajian/${s.slug}`}
                  class="block rounded-xl bg-mist p-2.5 transition hover:bg-[#DDE9DB]"
                  data-session={`${s.day}-${s.time}`}
                >
                  <span class="block text-sm font-extrabold text-forest">{formatTime(s.time)}</span>
                  <span class="mt-0.5 block text-[0.8rem] font-bold leading-snug text-ink">{s.title}</span>
                  <span class="badge mt-1.5 hidden bg-forest !px-2 !py-0.5 text-[0.62rem] text-white" data-next-badge>
                    Berikutnya
                  </span>
                </a>
              ))
            ) : (
              <p class="flex flex-1 items-center justify-center rounded-xl border border-dashed border-line p-2 text-center text-xs text-muted">
                Tidak ada kajian
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { activeKajian, teachers } from '../data/kajian';
  import { flattenSessions, todayWIB, upcoming } from '../lib/schedule';

  const root = document.querySelector<HTMLElement>('[data-week-strip]');
  if (root) {
    const today = todayWIB();
    const todayCol = root.querySelector<HTMLElement>(`[data-day="${today}"]`);
    todayCol?.classList.add('!border-gold', 'ring-1', 'ring-gold/40');
    todayCol?.querySelector('[data-today-badge]')?.classList.remove('hidden');
    const next = upcoming(flattenSessions(activeKajian, teachers))[0];
    const nextEl = root.querySelector<HTMLElement>(`[data-session="${next.day}-${next.time}"]`);
    nextEl?.classList.add('ring-2', 'ring-forest');
    nextEl?.querySelector('[data-next-badge]')?.classList.remove('hidden');
    // Gulirkan ke hari ini pada layar sempit
    if (todayCol && root.scrollWidth > root.clientWidth) root.scrollLeft = Math.max(0, todayCol.offsetLeft - 16);
  }
</script>
