---
import { CalendarDays, House, LayoutGrid, Search } from '@lucide/astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { href: '/', label: 'Beranda', icon: House, active: path === '/' },
  { href: '/program', label: 'Program', icon: LayoutGrid, active: path.startsWith('/program') },
  { href: '/kajian', label: 'Kajian', icon: CalendarDays, active: path.startsWith('/kajian') },
];
---

<nav
  aria-label="Navigasi cepat"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden"
>
  <ul class="grid h-16 grid-cols-4">
    {
      items.map(({ href, label, icon: Icon, active }) => (
        <li>
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            class:list={['flex h-full flex-col items-center justify-center gap-0.5 text-[0.72rem] font-bold', active ? 'text-forest' : 'text-muted']}
          >
            <span class:list={['flex h-7 w-12 items-center justify-center rounded-full', active && 'bg-mist']}>
              <Icon size={20} aria-hidden="true" />
            </span>
            {label}
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" data-search-open class="flex h-full w-full flex-col items-center justify-center gap-0.5 text-[0.72rem] font-bold text-muted">
        <span class="flex h-7 w-12 items-center justify-center rounded-full"><Search size={20} aria-hidden="true" /></span>
        Cari
      </button>
    </li>
  </ul>
</nav>
