---
import { Plus } from '@lucide/astro';

interface Props {
  items: { q: string; a: string; category?: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    items.map((f) => (
      <details class="faq group" data-faq data-category={f.category} data-search={`${f.q} ${f.a}`.toLowerCase()}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-[1.02rem] font-bold text-ink">
          {f.q}
          <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-mist text-forest transition-transform group-open:rotate-45">
            <Plus size={16} aria-hidden="true" />
          </span>
        </summary>
        <p class="-mt-1 pb-6 pr-12 text-muted">{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
