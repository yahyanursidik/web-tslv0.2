---
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: { label: string; href?: string }[];
  tone?: 'cream' | 'mist' | 'sand';
}
const { eyebrow, title, lead, crumbs, tone = 'cream' } = Astro.props;
const bg = { cream: 'bg-cream', mist: 'bg-mist', sand: 'bg-sand' }[tone];
---

<section class:list={[bg, 'pb-12 pt-8 md:pb-16 md:pt-10']}>
  <div class="container-site">
    <Breadcrumb items={crumbs} />
    <div class="mt-8 grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1 class="mt-3 text-[2.2rem] font-extrabold leading-[1.12] md:text-[3.1rem]">{title}</h1>
        {lead && <p class="mt-4 max-w-2xl text-[1.08rem] text-muted">{lead}</p>}
      </div>
      <slot name="aside" />
    </div>
    <slot />
  </div>
</section>
